# Copy to .env and fill in. Never commit .env.
TAVILY_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides
# OPENROUTER_MODEL=openai/gpt-oss-120b
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=sentinel_ai
# Public deployment protection (api/security.py) — read docs/THREAT_MODEL.md before deploying
# TRUST_PROXY=true                 # ONLY behind a proxy that sets X-Forwarded-For (Render: yes). Else rate limits are spoofable
# PIPELINE_MAX_CONCURRENT=4        # searches in flight per process; beyond that → 503 + Retry-After
# LLM_DAILY_BUDGET_USD=2           # hard LLM spend ceiling per day (0 = unlimited); app degrades to fallbacks
# MAX_WATCHES=20
# MAX_QUERY_LENGTH=200
# HTTP_TIMEOUT_SECONDS=20
# ALERT_ON_DISPUTED=true           # watchlist also alerts when a claim becomes disputed
# ALERT_SURGE_FACTOR=2.0           # …and when a watched topic's story count doubles between runs (0 = off)
# DEMO_MODE=false                  # true = no keys, no network, fictional data, in-memory store (never in production)
# SENTINEL_API_KEY=change-me-long-random
# ALLOWED_ORIGINS=https://nikhil-956653.github.io
# RATE_LIMIT_PER_MINUTE=30
# EXPENSIVE_LIMIT_PER_MINUTE=8
# CONTRADICTION_MODE=llm
# CLAIMS_ENABLED=true              # claim-level corroboration (1 LLM call per fresh search)
# ENTITIES_ENABLED=true            # entity extraction for the knowledge graph (1 LLM call per fresh search)
# REDIS_URL=redis://localhost:6379/0   # share the rate-limit window across instances (falls back to memory)
# LOG_FORMAT=json                  # one JSON object per request line (default: text)
# LLM_PRICE_IN_PER_M=0.15          # $/1M tokens, used to estimate cost when OpenRouter omits it
# LLM_PRICE_OUT_PER_M=0.60
# Daily brief (services/brief.py)
# BRIEF_WINDOW_HOURS=24            # how far back the SITREP looks
# BRIEF_CACHE_HOURS=6              # regenerate at most this often (REGENERATE button forces it)
# BRIEF_INTERVAL_HOURS=24          # push to Telegram this often when a bot is configured (0 = never)
# Watchlist alerts — create a bot with @BotFather, get your chat id from @userinfobot
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# WATCHLIST_INTERVAL_MINUTES=60
# WATCHLIST_ENABLED=true
# PUBLIC_SITE_URL=https://your-app.onrender.com/app
